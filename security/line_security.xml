<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_line" model="ir.module.category">
            <field name="name">LINE</field>
            <field name="description">LINE 平台整合管理</field>
            <field name="sequence">50</field>
        </record>
        <record id="group_line_user" model="res.groups">
            <field name="name">LINE 使用者</field>
            <field name="category_id" ref="module_category_line"/>
        </record>
        <record id="group_line_manager" model="res.groups">
            <field name="name">LINE 管理者</field>
            <field name="category_id" ref="module_category_line"/>
            <field name="implied_ids" eval="[(4, ref('group_line_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
