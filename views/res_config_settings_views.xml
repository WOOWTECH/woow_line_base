<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LINE Base 不再提供獨立設定分頁，API 金鑰統一在 LINE Bridge / LiveChat 模組管理 -->
    <!-- 保留空 view record 以確保升級時覆蓋舊版 arch -->
    <record id="res_config_settings_view_form_line" model="ir.ui.view">
        <field name="name">res.config.settings.form.line.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <!-- intentionally empty -->
            </xpath>
        </field>
    </record>
</odoo>
