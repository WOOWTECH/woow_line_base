<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="line_bind_partner_wizard_form" model="ir.ui.view">
        <field name="name">line.bind.partner.wizard.form</field>
        <field name="model">line.bind.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="綁定聯絡人">
                <group>
                    <field name="line_user_id" invisible="1"/>
                    <field name="partner_id"
                           options="{'no_create': False}"
                           placeholder="搜尋或建立聯絡人..."/>
                </group>
                <footer>
                    <button string="綁定" type="object" name="action_bind"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
